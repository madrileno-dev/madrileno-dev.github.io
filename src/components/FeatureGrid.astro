---
import keyRound from "lucide-static/icons/key-round.svg?raw";
import calendarClock from "lucide-static/icons/calendar-clock.svg?raw";
import mailbox from "lucide-static/icons/mailbox.svg?raw";
import radio from "lucide-static/icons/radio.svg?raw";
import plugZap from "lucide-static/icons/plug-zap.svg?raw";
import flag from "lucide-static/icons/flag.svg?raw";
import image from "lucide-static/icons/image.svg?raw";
import gauge from "lucide-static/icons/gauge.svg?raw";
import activity from "lucide-static/icons/activity.svg?raw";
import mail from "lucide-static/icons/mail.svg?raw";
import globe from "lucide-static/icons/globe.svg?raw";
import databaseZap from "lucide-static/icons/database-zap.svg?raw";

const icons: Record<string, string> = {
  "key-round": keyRound, "calendar-clock": calendarClock, mailbox, radio, "plug-zap": plugZap, flag,
  image, gauge, activity, mail, globe, "database-zap": databaseZap,
};

const features = [
  { icon: "key-round", title: "Sign-in and sessions", href: "/docs/auth/", text: "Let people sign in with Google, a company SSO or email. Sessions refresh themselves, and a dev login keeps you working offline." },
  { icon: "calendar-clock", title: "Background jobs", href: "/docs/scheduler/", text: "Run work on a schedule, or once at a chosen time. Jobs outlive restarts, retry on failure and show up in an admin view." },
  { icon: "mailbox", title: "Reliable events", href: "/docs/outbox/", text: "Tell other systems what happened, but only once the change is really committed. Failed deliveries retry, then wait to be replayed." },
  { icon: "radio", title: "Internal events", href: "/docs/event-bus/", text: "Let one part of the app react to another without the two depending on each other. The same code works on one instance or a dozen." },
  { icon: "plug-zap", title: "Live updates", href: "/docs/websockets/", text: "Push changes to open browser connections as they happen, in a stable public shape clients can build against." },
  { icon: "flag", title: "Feature flags", href: "/docs/feature-flags/", text: "Ship code switched off, turn it on for one customer, then roll it out by percentage. Changing your mind costs no deploy." },
  { icon: "image", title: "Uploads and images", href: "/docs/file-storage/", text: "Accept files, keep them on disk or in the cloud, and resize, crop or strip metadata on the way through." },
  { icon: "gauge", title: "Rate limits", href: "/docs/rate-limiting/", text: "Cap how often an endpoint can be called, per user, per IP or per key, so one bad client cannot ruin the afternoon." },
  { icon: "activity", title: "When something breaks", href: "/docs/observability/", text: "Traces, metrics and logs from the first request. Every error a caller sees carries an id you can search for." },
  { icon: "mail", title: "Email", href: "/docs/mailer/", text: "Typed templates, queued and retried like any other job. In development they land in a local inbox instead of a real one." },
  { icon: "globe", title: "Third-party APIs", href: "/docs/external-apis/", text: "One shape for calling someone else's service, with a fake to drop in so your tests stay fast and offline." },
  { icon: "database-zap", title: "Caching", href: "/docs/cache/", text: "Hold expensive answers in memory behind an interface small enough to swap out or delete." },
];

const iconSvg = (name: string) =>
  icons[name]
    .replace(/<!--[\s\S]*?-->\s*/, "")
    .replace(/\s*class="[^"]*"/, "")
    .replace(/width="24"\s+height="24"/, 'width="22" height="22" aria-hidden="true" focusable="false"');
---
<div class="m-grid">
  {features.map((f) => (
    <a class="m-card feature" href={f.href}>
      <span class="feature__icon"><Fragment set:html={iconSvg(f.icon)} /></span>
      <h3>{f.title}</h3>
      <p>{f.text}</p>
    </a>
  ))}
</div>
<style>
  .feature__icon { display: inline-flex; color: var(--m-accent); margin-bottom: 0.75rem; }
</style>
