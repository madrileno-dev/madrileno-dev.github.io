---
import { links } from "../site.ts";
import { flags } from "../flags.ts";
---
<footer class="m-footer">
  <div class="m-container m-footer__row">
    <p class="m-muted">Apache-2.0. Projects generated from the template are yours to license.</p>
    <nav aria-label="Footer">
      <a href={links.org} rel="noopener">github.com/madrileno-dev</a>
      {flags.support && <a href="/support/">Support</a>}
    </nav>
  </div>
</footer>
<style>
  .m-footer { border-top: 1px solid var(--m-line); padding-block: 2rem; font-size: 0.9rem; }
  .m-footer__row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; }
  .m-footer nav { display: flex; gap: 1.25rem; }
</style>
