---
import BrandLogo from "./BrandLogo.astro";
import SiteNav from "./SiteNav.astro";
import ThemeToggle from "./ThemeToggle.astro";
---
<header class="m-header">
  <a class="m-header__brand" href="/" aria-label="madrileño home"><BrandLogo height={32} /></a>
  <div class="m-header__right">
    <SiteNav />
    <span class="m-header__divider" aria-hidden="true"></span>
    <ThemeToggle />
  </div>
</header>
<style>
  .m-header { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 3.5rem; padding-inline: 1rem; background: var(--m-bg); border-bottom: 1px solid var(--m-line); }
  .m-header__brand { display: inline-flex; text-decoration: none; }
  .m-header__right { display: flex; align-items: center; gap: 1rem; }
  .m-header__divider { height: 2rem; border-inline-end: 1px solid var(--m-line-strong); }
  @media (min-width: 50rem) { .m-header { height: 4rem; padding-inline: 1.5rem; } }
  @media (max-width: 40rem) { .m-header__divider { display: none; } .m-header__right { gap: 0.75rem; } }
</style>
