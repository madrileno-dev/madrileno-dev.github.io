---
import { navLinks } from "../site.ts";
import BrandLogo from "./BrandLogo.astro";
import ThemeToggle from "./ThemeToggle.astro";
const items = navLinks();
---
<header class="m-header">
  <a class="m-header__brand" href="/" aria-label="madrileño home"><BrandLogo height={32} /></a>
  <nav aria-label="Site" class="m-header__nav">
    {items.map((l) => <a href={l.href} rel={l.external ? "noopener" : undefined}>{l.label}</a>)}
    <ThemeToggle />
  </nav>
</header>
<style>
  .m-header { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 3.5rem; padding-inline: 1rem; background: color-mix(in srgb, var(--m-bg) 88%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--m-line); }
  .m-header__brand { display: inline-flex; text-decoration: none; }
  .m-header__nav { display: flex; align-items: center; gap: 1.25rem; }
  .m-header__nav a { color: var(--m-ink); text-decoration: none; font-weight: 500; }
  .m-header__nav a:hover { color: var(--m-accent); }
  @media (min-width: 50rem) { .m-header { padding-inline: 1.5rem; } }
  @media (max-width: 40rem) { .m-header__nav { gap: 0.9rem; font-size: 0.95rem; } }
</style>
