---
import sun from "lucide-static/icons/sun.svg?raw";
import moon from "lucide-static/icons/moon.svg?raw";
import monitor from "lucide-static/icons/monitor.svg?raw";
const icon = (s: string) =>
  s.replace(/<!--[\s\S]*?-->\s*/, "").replace(/\s*class="[^"]*"/, "").replace(/width="24"\s+height="24"/, 'width="16" height="16" aria-hidden="true" focusable="false"');
const options = [
  { value: "light", label: "Light theme", svg: sun },
  { value: "dark", label: "Dark theme", svg: moon },
  { value: "auto", label: "Follow system theme", svg: monitor },
];
---
<div class="m-theme" role="group" aria-label="Colour theme" data-theme-switch>
  {options.map((o) => (
    <button type="button" data-theme-value={o.value} aria-label={o.label} title={o.label} aria-pressed="false">
      <Fragment set:html={icon(o.svg)} />
    </button>
  ))}
</div>
<script>
  const KEY = "starlight-theme";
  type Theme = "light" | "dark" | "auto";
  const stored = (): Theme => {
    try {
      const v = localStorage.getItem(KEY);
      return v === "light" || v === "dark" ? v : "auto";
    } catch {
      return "auto";
    }
  };
  const apply = (t: Theme) => {
    const dark = t === "dark" || (t === "auto" && window.matchMedia("(prefers-color-scheme: dark)").matches);
    document.documentElement.dataset.theme = dark ? "dark" : "light";
    document.querySelectorAll<HTMLButtonElement>("[data-theme-switch] button").forEach((b) => {
      b.setAttribute("aria-pressed", b.dataset.themeValue === t ? "true" : "false");
    });
  };
  document.querySelectorAll<HTMLButtonElement>("[data-theme-switch] button").forEach((b) => {
    b.addEventListener("click", () => {
      const t = b.dataset.themeValue as Theme;
      try {
        if (t === "auto") localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, t);
      } catch {}
      apply(t);
    });
  });
  apply(stored());
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => apply(stored()));
</script>
<style>
  .m-theme { display: inline-flex; padding: 2px; border: 1px solid var(--m-line); border-radius: 999px; background: var(--m-bg-raised); }
  .m-theme button { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border: 0; border-radius: 999px; background: none; color: var(--m-ink-muted); cursor: pointer; padding: 0; transition: background 150ms, color 150ms; }
  .m-theme button:hover { color: var(--m-ink); }
  .m-theme button[aria-pressed="true"] { background: var(--m-accent); color: #fff; }
  .m-theme button:focus-visible { outline: 2px solid var(--m-accent); outline-offset: 2px; }
</style>
