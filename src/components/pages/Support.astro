---
import Reveal from "../Reveal.astro";
import { links } from "../../site.ts";
---
<section class="m-section m-section--flush">
  <div class="m-container support">
    <Reveal>
      <p class="m-eyebrow">Paid support and consulting</p>
      <p class="by"><span class="m-muted">by</span> <a href={links.iterators} rel="noopener">Iterators</a></p>
      <h1>Build on madrileño with the team that wrote it.</h1>
      <p class="lede">madrileño is built and maintained by <a href={links.iterators} rel="noopener">Iterators</a>, a software studio that ships products for founders and product teams. If you are starting on the template, we get you moving faster than the docs alone.</p>
      <a class="m-button m-button--primary" href={links.iteratorsContact} rel="noopener">Schedule a call</a>
    </Reveal>
  </div>
</section>
<section class="m-section">
  <div class="m-container">
    <Reveal><h2>What we do around it</h2></Reveal>
    <Reveal class="m-grid offers">
      <div class="m-card"><h3>Kickoff</h3><p>We stand your project up on the template and adapt the first modules to your domain, with your team in the loop from day one.</p></div>
      <div class="m-card"><h3>Build</h3><p>We build the product on it, backend and frontend, as an extension of your team. You own every line.</p></div>
      <div class="m-card"><h3>Review</h3><p>A second pair of eyes on architecture, security and the parts of the template you changed, before they reach production.</p></div>
      <div class="m-card"><h3>Support</h3><p>Upgrades from upstream, incidents and questions, answered by people who know the code.</p></div>
    </Reveal>
  </div>
</section>
<section class="m-section">
  <div class="m-container two-col">
    <Reveal><h2>Who this is for</h2></Reveal>
    <Reveal>
      <p>Founders and small teams who need a backend that holds up, without a platform team to keep it that way.</p>
      <p>Tell us what you are building and where you are stuck. We reply within two working days.</p>
      <a class="m-button m-button--primary" href={links.iteratorsContact} rel="noopener">Talk to Iterators</a>
    </Reveal>
  </div>
</section>
<style>
  .support { padding-top: clamp(3rem, 10vw, 6rem); }
  .support > :global(.m-reveal) { max-width: 46rem; }
  .by { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem; font-family: var(--m-font-display); font-weight: 600; }
  .lede { font-size: 1.2rem; }
  .two-col { display: grid; gap: 2rem 4rem; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  @media (max-width: 48rem) { .two-col { grid-template-columns: 1fr; } }
</style>
